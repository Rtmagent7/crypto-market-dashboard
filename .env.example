# Copy to .env.local (gitignored). Never prefix provider keys with NEXT_PUBLIC_.

# Core providers
COINGECKO_API_KEY=
TWELVEDATA_API_KEY=
GROQ_API_KEY=

# Serverless Redis (rediss:// only)
REDIS_URL=
REDIS_TOKEN=

# Secrets (>= 32 random chars each)
CRON_SECRET=
IP_HASH_SALT=

# Backup providers
CMC_API_KEY=
FINNHUB_API_KEY=
EXCHANGERATE_API_KEY=
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Recommended
ALERT_WEBHOOK_URL=

# Optional
BPS_API_KEY=

# Dev only: 1 = MSW server-side mocks, zero provider calls
MOCK_PROVIDERS=1

# Preview deployments: 0.1 (OPEN DECISION #5)
BUDGET_CAP_RATIO=1.0

# Stretch (S1 status history)
DATABASE_URL=
