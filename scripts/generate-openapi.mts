// Generates docs/openapi.yaml from the Zod contract. `--check` fails when the file is stale
// (used in CI so the spec can never drift from the code).
import { readFileSync, writeFileSync } from "node:fs";

import { OpenApiGeneratorV31 } from "@asteasolutions/zod-to-openapi";
import { stringify } from "yaml";

import { registry } from "../src/app/api/_lib/contract";

const OUT = "docs/openapi.yaml";
const document = new OpenApiGeneratorV31(registry.definitions).generateDocument({
  openapi: "3.1.0",
  info: {
    title: "Tidewater internal API",
    version: "0.1.0",
    description:
      "Same-origin API for the dashboard. Every route returns a DataEnvelope; providers are " +
      "never called more often than their cache TTL allows.",
  },
  servers: [{ url: "/" }],
});
const yaml = `# Generated by scripts/generate-openapi.mts — do not edit by hand.\n${stringify(document)}`;

if (process.argv.includes("--check")) {
  let current = "";
  try {
    current = readFileSync(OUT, "utf8");
  } catch {
    // Missing file counts as stale.
  }
  if (current !== yaml) {
    console.error(`${OUT} is out of date. Run \`npm run openapi\` and commit the result.`);
    process.exit(1);
  }
  console.log(`${OUT} is up to date.`);
} else {
  writeFileSync(OUT, yaml);
  console.log(`Wrote ${OUT}`);
}
