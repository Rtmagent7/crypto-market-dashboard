# Copy to .env.local (gitignored). Never prefix provider keys with NEXT_PUBLIC_.

# Core providers
COINGECKO_API_KEY=
TWELVEDATA_API_KEY=
GROQ_API_KEY=

# Redis over the Upstash REST protocol (https:// in production).
# Vercel Marketplace (Upstash) injects KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# A direct Upstash database can use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
# Local: `docker compose up -d redis-http` → http://localhost:8079 with token local-dev-token.
# Leave empty with MOCK_PROVIDERS=1 to use the in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Integration tests against real Redis (optional locally, set in CI)
TEST_REDIS_URL=
TEST_REDIS_TOKEN=

# Secrets (>= 32 random chars each)
CRON_SECRET=
IP_HASH_SALT=

# Backup providers
CMC_API_KEY=
FINNHUB_API_KEY=
EXCHANGERATE_API_KEY=
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Recommended
ALERT_WEBHOOK_URL=

# Optional
BPS_API_KEY=

# Dev only: 1 = MSW server-side mocks, zero provider calls
MOCK_PROVIDERS=1

# Preview deployments: 0.1 (OPEN DECISION #5)
BUDGET_CAP_RATIO=1.0

# Stretch (S1 status history)
DATABASE_URL=
